CHIP CPU {
 IN inM[16], instruction[16], reset;
 OUT outM[16], writeM, addressM[15], pc[15];
 PARTS:
 Not(in=instruction[15], out=isA);
 And(a=instruction[15], b=instruction[5], out=destA);
 Or(a=isA,b=destA,out=loadA);
 Mux16(a=instruction,b=aluOut,sel=instruction[15],out=aIn);
 ARegister(in=aIn,load=loadA,out=a,out[0..14]=addressM);
 And(a=instruction[15],b=instruction[4],out=loadD);
 DRegister(in=aluOut,load=loadD,out=d);
 Mux16(a=a,b=inM,sel=instruction[12],out=y);
 ALU(x=d,y=y,zx=instruction[11],nx=instruction[10],zy=instruction[9],ny=instruction[8],f=instruction[7],no=instruction[6],out=aluOut,out=outM,zr=zr,ng=ng);
 And(a=instruction[15],b=instruction[3],out=writeM);
 Or(a=zr,b=ng,out=nonPositive);
 Not(in=nonPositive,out=positive);
 And(a=instruction[0],b=positive,out=jgt);
 And(a=instruction[1],b=zr,out=jeq);
 And(a=instruction[2],b=ng,out=jlt);
 Or(a=jgt,b=jeq,out=j1);
 Or(a=j1,b=jlt,out=j2);
 And(a=instruction[15],b=j2,out=jump);
 PC(in=a,load=jump,inc=true,reset=reset,out[0..14]=pc);
}

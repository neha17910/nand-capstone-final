CHIP Memory {
 IN in[16], load, address[15];
 OUT out[16];
 PARTS:
 Not(in=address[14],out=ramSel);
 And(a=load,b=ramSel,out=ramLoad);
 Not(in=address[13],out=screenSel);
 And(a=address[14],b=screenSel,out=screenRegion);
 And(a=load,b=screenRegion,out=screenLoad);
 RAM16K(in=in,load=ramLoad,address=address[0..13],out=ram);
 Screen(in=in,load=screenLoad,address=address[0..12],out=screen);
 Keyboard(out=key);
 Mux16(a=screen,b=key,sel=address[13],out=io);
 Mux16(a=ram,b=io,sel=address[14],out=out);
}
